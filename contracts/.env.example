# Loaded via `dotenv/config` in hardhat.config.ts and read through Hardhat's
# `configVariable(...)` — see docs/context.md §4 and the "Local development" section of
# README.md. Not needed for local Hardhat work (`npm run node`, `npm test`,
# `npm run deploy:local`); only required when targeting Sepolia.

# RPC endpoint for the Sepolia testnet (e.g. an Alchemy or Infura project URL).
SEPOLIA_RPC_URL=

# Private key of a Sepolia account funded with test ETH. Never a mainnet key.
SEPOLIA_PRIVATE_KEY=

# Optional: enables `npx hardhat verify` against Etherscan after a Sepolia deployment.
ETHERSCAN_API_KEY=
