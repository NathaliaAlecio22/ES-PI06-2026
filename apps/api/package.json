{
  "name": "provenance-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "shared:build": "npm --prefix ../../packages/shared run build",
    "predev": "npm run shared:build",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run shared:build",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "postinstall": "npm run build --prefix ../../packages/shared",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "pretest:custodia": "npm run shared:build",
    "test:custodia": "tsc -p tsconfig.json --outDir dist-test && node --test dist-test/tests/custodia.fluxo.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@provenance/shared": "file:../../packages/shared",
    "dotenv": "^18.0.10",
    "ethers": "^6.17.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "prisma": "^7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
