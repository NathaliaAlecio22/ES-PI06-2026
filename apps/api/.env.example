NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/provenance
# Local Hardhat node defaults (see contracts/README.md): `npx hardhat node` in contracts/
# serves JSON-RPC at this URL with this chain id.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Printed by `npm run deploy:local` in contracts/ after deploying WorkflowFactory there.
WORKFLOW_FACTORY_ADDRESS=
# One of the pre-funded local accounts `npx hardhat node` prints on startup. The default below
# is account #0's well-known, publicly documented Hardhat test key — fine for local dev only,
# never use it (or any account derived from the standard Hardhat mnemonic) on a real network.
TRANSACTION_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SESSION_SECRET=
